# ZapChat
#
# This file replaces the 400-line Visual Studio template that used to live here. That
# version had UTF-16 bytes spliced into it partway through, which made git classify
# .gitignore itself as a binary file — so its diffs were unreadable and the rules after
# the corruption were never applied.

# ── .NET build output ─────────────────────────────────────────────────────────
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
artifacts/
*.binlog

# ── IDE and user-specific ─────────────────────────────────────────────────────
.vs/
.idea/
*.user
*.rsuser
*.suo
*.userosscache
*.sln.docstates
*.slnLaunch.user
*.DotSettings.user

# ── Node / frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/dist/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# ── Secrets and local overrides ───────────────────────────────────────────────
# The JWT signing key, Gemini API key, SMTP password and VAPID private key are all
# supplied through the environment (see scripts/dev-env.ps1). None belong in the repo.
.env
.env.local
.env.*.local
appsettings.Local.json
scripts/dev-secrets.ps1
*.pfx
*.snk

# ── Runtime output ────────────────────────────────────────────────────────────
# Service logs and uploaded files are produced by running the app, not by developing it.
logs/
*.log
**/App_Data/

# ── OS noise ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
