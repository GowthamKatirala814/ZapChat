{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MongoDB": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "Database": "zapchat_auth",
    "FailFastOnIndexError": false
  },

  "Jwt": {
    "Issuer": "ZapChat",
    "Audience": "ZapChatUsers",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
    // Jwt:Secret is intentionally absent. Supply it with:
    //   dotnet user-secrets set "Jwt:Secret" "<at least 32 chars>"
    // or the ZAPCHAT_JWT__SECRET environment variable. Startup fails without it.
  },

  "AuthCookies": {
    "SameSite": "Lax",
    "Secure": true
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "https://localhost:5173" ]
  },

  "ServiceUrls": {
    "ChatService": "http://localhost:5139",
    "Gateway": "https://localhost:5000"
  },

  "AdminSettings": {
    "AdminEmail": ""
  },

  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderName": "ZapChat",
    "SenderEmail": "",
    "UseLogTransport": true
    // AppPassword comes from user-secrets / ZAPCHAT_EMAIL__APPPASSWORD.
    // UseLogTransport=true writes OTP codes to the log so the flows can be
    // exercised locally with no SMTP account.
  },

  "Gemini": {
    "Model": "gemini-2.5-flash",
    "TimeoutSeconds": 10,
    "EstimatedDailyQuota": 1500
    // ApiKey comes from user-secrets / ZAPCHAT_GEMINI__APIKEY.
    // Absent means AI moderation reports itself unavailable; the local
    // rule-based pipeline still runs.
  }
}
