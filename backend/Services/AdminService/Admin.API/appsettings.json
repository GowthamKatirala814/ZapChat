{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MongoDB": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "Database": "zapchat_admin",
    "FailFastOnIndexError": false
  },
  "Jwt": {
    "Issuer": "ZapChat",
    "Audience": "ZapChatUsers",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "ServiceUrls": {
    "AuthService": "http://localhost:5111",
    "ChatService": "http://localhost:5139",
    "PrivateChatService": "http://localhost:5172",
    "PollService": "http://localhost:5292",
    "NotificationService": "http://localhost:5262",
    "Gateway": "https://localhost:5000"
  }
}