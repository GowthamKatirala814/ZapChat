{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MongoDB": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "Database": "zapchat_privatechat",
    "FailFastOnIndexError": false
  },

  "Jwt": {
    "Issuer": "ZapChat",
    "Audience": "ZapChatUsers",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "https://localhost:5173" ]
  },

  "ServiceUrls": {
    "AuthService": "http://localhost:5111",
    "NotificationService": "http://localhost:5262",
    "Gateway": "https://localhost:5000"
  }
}
