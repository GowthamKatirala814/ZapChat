{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "https://localhost:5173" ]
  },

  "ReverseProxy": {

    "Routes": {

      // ── Auth ────────────────────────────────────────────────────────────────
      "auth-login": {
        "ClusterId": "auth",
        "RateLimiterPolicy": "login",
        "Match": { "Path": "/api/auth/login", "Methods": [ "POST" ] }
      },
      "auth-register": {
        "ClusterId": "auth",
        "RateLimiterPolicy": "register",
        "Match": { "Path": "/api/auth/register/{**catch-all}", "Methods": [ "POST" ] }
      },
      // Password reset and OTP verification are brute-forceable, so they get the
      // strict limiter too. Previously they fell through to the general 300/min
      // policy, which made a 6-digit code feasible to guess.
      "auth-password-reset": {
        "ClusterId": "auth",
        "RateLimiterPolicy": "register",
        "Match": { "Path": "/api/auth/forgot-password", "Methods": [ "POST" ] }
      },
      "auth-verify-otp": {
        "ClusterId": "auth",
        "RateLimiterPolicy": "register",
        "Match": { "Path": "/api/auth/verify-otp", "Methods": [ "POST" ] }
      },
      "auth-reset-password": {
        "ClusterId": "auth",
        "RateLimiterPolicy": "register",
        "Match": { "Path": "/api/auth/reset-password", "Methods": [ "POST" ] }
      },
      "auth-refresh": {
        "ClusterId": "auth",
        "RateLimiterPolicy": "refresh",
        "Match": { "Path": "/api/auth/refresh", "Methods": [ "POST" ] }
      },
      "auth-general": {
        "ClusterId": "auth",
        "RateLimiterPolicy": "general",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },

      // ── Chat ────────────────────────────────────────────────────────────────
      "chat-rooms": {
        "ClusterId": "chat",
        "RateLimiterPolicy": "general",
        "Match": { "Path": "/api/rooms/{**catch-all}" }
      },
      "chat-messages": {
        "ClusterId": "chat",
        "RateLimiterPolicy": "general",
        "Match": { "Path": "/api/messages/{**catch-all}" }
      },
      "chat-files": {
        "ClusterId": "chat",
        "RateLimiterPolicy": "upload",
        "Match": { "Path": "/api/files/{**catch-all}" }
      },
      "chat-admin": {
        "ClusterId": "chat",
        "RateLimiterPolicy": "general",
        "Match": { "Path": "/api/chat-admin/{**catch-all}" }
      },
      "chat-hub": {
        "ClusterId": "chat",
        "RateLimiterPolicy": "realtime",
        "Match": { "Path": "/hubs/chat/{**catch-all}" }
      },
      "chat-hub-root": {
        "ClusterId": "chat",
        "RateLimiterPolicy": "realtime",
        "Match": { "Path": "/hubs/chat" }
      },

      // ── Private chat ────────────────────────────────────────────────────────
      "private-conversations": {
        "ClusterId": "privatechat",
        "RateLimiterPolicy": "general",
        "Match": { "Path": "/api/conversations/{**catch-all}" }
      },
      "private-messages": {
        "ClusterId": "privatechat",
        "RateLimiterPolicy": "general",
        "Match": { "Path": "/api/direct-messages/{**catch-all}" }
      },
      "private-blocks": {
        "ClusterId": "privatechat",
        "RateLimiterPolicy": "general",
        "Match": { "Path": "/api/blocks/{**catch-all}" }
      },
      "private-admin": {
        "ClusterId": "privatechat",
        "RateLimiterPolicy": "general",
        "Match": { "Path": "/api/privatechat-admin/{**catch-all}" }
      },
      "private-hub": {
        "ClusterId": "privatechat",
        "RateLimiterPolicy": "realtime",
        "Match": { "Path": "/hubs/private-chat/{**catch-all}" }
      },
      "private-hub-root": {
        "ClusterId": "privatechat",
        "RateLimiterPolicy": "realtime",
        "Match": { "Path": "/hubs/private-chat" }
      },

      // ── Polls ───────────────────────────────────────────────────────────────
      "polls": {
        "ClusterId": "poll",
        "RateLimiterPolicy": "general",
        "Match": { "Path": "/api/polls/{**catch-all}" }
      },
      "poll-admin": {
        "ClusterId": "poll",
        "RateLimiterPolicy": "general",
        "Match": { "Path": "/api/poll-admin/{**catch-all}" }
      },
      "poll-hub": {
        "ClusterId": "poll",
        "RateLimiterPolicy": "realtime",
        "Match": { "Path": "/hubs/polls/{**catch-all}" }
      },
      "poll-hub-root": {
        "ClusterId": "poll",
        "RateLimiterPolicy": "realtime",
        "Match": { "Path": "/hubs/polls" }
      },

      // ── Notifications ───────────────────────────────────────────────────────
      // Routes are enumerated rather than using a catch-all so that
      // /api/notifications/internal — the service-to-service creation endpoint — is
      // not proxied at all. A {id:guid} constraint keeps "internal" from matching the
      // per-notification routes.
      "notifications": {
        "ClusterId": "notification",
        "RateLimiterPolicy": "general",
        "Match": { "Path": "/api/notifications" }
      },
      "notifications-unread": {
        "ClusterId": "notification",
        "RateLimiterPolicy": "general",
        "Match": { "Path": "/api/notifications/unread-count" }
      },
      "notifications-read-all": {
        "ClusterId": "notification",
        "RateLimiterPolicy": "general",
        "Match": { "Path": "/api/notifications/read-all" }
      },
      "notifications-item": {
        "ClusterId": "notification",
        "RateLimiterPolicy": "general",
        "Match": { "Path": "/api/notifications/{id:guid}" }
      },
      "notifications-item-read": {
        "ClusterId": "notification",
        "RateLimiterPolicy": "general",
        "Match": { "Path": "/api/notifications/{id:guid}/read" }
      },
      "notifications-push": {
        "ClusterId": "notification",
        "RateLimiterPolicy": "general",
        "Match": { "Path": "/api/notifications/push/{**catch-all}" }
      },
      "notification-admin": {
        "ClusterId": "notification",
        "RateLimiterPolicy": "general",
        "Match": { "Path": "/api/notification-admin/{**catch-all}" }
      },
      "notification-hub": {
        "ClusterId": "notification",
        "RateLimiterPolicy": "realtime",
        "Match": { "Path": "/hubs/notifications/{**catch-all}" }
      },
      "notification-hub-root": {
        "ClusterId": "notification",
        "RateLimiterPolicy": "realtime",
        "Match": { "Path": "/hubs/notifications" }
      },

      // ── Admin ───────────────────────────────────────────────────────────────
      "admin": {
        "ClusterId": "admin",
        "RateLimiterPolicy": "general",
        "Match": { "Path": "/api/admin/{**catch-all}" }
      },
      "reports": {
        "ClusterId": "admin",
        "RateLimiterPolicy": "report",
        "Match": { "Path": "/api/reports/{**catch-all}" }
      }
    },

    "Clusters": {
      "auth": { "Destinations": { "d1": { "Address": "http://localhost:5111/" } } },
      "chat": { "Destinations": { "d1": { "Address": "http://localhost:5139/" } } },
      "privatechat": { "Destinations": { "d1": { "Address": "http://localhost:5172/" } } },
      "poll": { "Destinations": { "d1": { "Address": "http://localhost:5292/" } } },
      "notification": { "Destinations": { "d1": { "Address": "http://localhost:5262/" } } },
      "admin": { "Destinations": { "d1": { "Address": "http://localhost:5145/" } } }
    }
  },

  "HealthChecks": {
    "Services": {
      "auth": "http://localhost:5111/health/ready",
      "chat": "http://localhost:5139/health/ready",
      "privatechat": "http://localhost:5172/health/ready",
      "poll": "http://localhost:5292/health/ready",
      "notification": "http://localhost:5262/health/ready",
      "admin": "http://localhost:5145/health/ready"
    }
  }
}
