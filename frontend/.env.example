# ZapChat frontend configuration.
# Copy to .env.local and adjust. Nothing here is secret — Vite inlines VITE_* values
# into the bundle, so never put a private key or password in this file.

# API gateway origin.
#
# LEAVE EMPTY for local development. Empty means "same origin", so requests stay relative
# and route through the Vite dev server's proxy (vite.config.ts) to the gateway.
#
# Why it matters: the session cookies are SameSite=Lax, and browsers do not send those on
# cross-site requests. An absolute origin here makes http://localhost:5173 -> 
# https://localhost:5000 cross-site, so login succeeds and then every authenticated
# request comes back 401 — which looks like "your session has expired".
#
# In production, serve the SPA and the API from one origin and leave this empty too. Use
# an absolute origin only if they genuinely differ, and then set the backend to
# SameSite=None as well.
VITE_API_URL=

# SignalR origin. Same rule; empty follows the page's origin.
VITE_HUB_URL=

# Web push public key. Leave empty to disable push in the UI — this must match the
# server's WebPush:PublicKey, which is also empty by default.
# Generate a pair with:  npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
