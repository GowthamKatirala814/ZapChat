# ZapChat frontend configuration.
# Copy to .env.local and adjust. Nothing here is secret — Vite inlines VITE_* values
# into the bundle, so never put a private key or password in this file.

# API gateway origin. All REST and SignalR traffic goes through it.
VITE_API_URL=https://localhost:5000

# SignalR origin. Usually the same as VITE_API_URL; separate so a deployment can put
# WebSocket traffic on another host.
VITE_HUB_URL=https://localhost:5000

# Web push public key. Leave empty to disable push in the UI — this must match the
# server's WebPush:PublicKey, which is also empty by default.
# Generate a pair with:  npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
