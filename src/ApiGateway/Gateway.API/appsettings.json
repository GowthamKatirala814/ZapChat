{
  "AllowedOrigins": "",

  "HealthCheckUrls": {
    "AuthService": "http://localhost:5111/health",
    "ChatService": "http://localhost:5139/health",
    "AdminService": "http://localhost:5145/health",
    "PrivateChatService": "http://localhost:5172/health",
    "NotificationService": "http://localhost:5262/health",
    "PollService": "http://localhost:5292/health"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },

  "ReverseProxy": {

    "Routes": {

      "auth-login": {
        "ClusterId": "auth-cluster",
        "RateLimiterPolicy": "login-limit",
        "Match": { "Path": "/api/auth/login", "Methods": [ "POST" ] },
        "Transforms": [
          { "ResponseHeaderRemove": "Access-Control-Allow-Origin" },
          { "ResponseHeaderRemove": "Access-Control-Allow-Credentials" },
          { "ResponseHeaderRemove": "Access-Control-Allow-Methods" },
          { "ResponseHeaderRemove": "Access-Control-Allow-Headers" }
        ]
      },

      "auth-register": {
        "ClusterId": "auth-cluster",
